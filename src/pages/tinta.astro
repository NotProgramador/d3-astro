---
import BaseLayout from '../layouts/BaseLayout.astro';

const featured = ['09', '08', '07', '06', '05', '04'];
const archive  = ['01', '02', '03', '04', '05', '06', '07', '08', '09'];
---

<BaseLayout title="Tinta — D³">
  <section class="tinta-hero">
    <p class="eyebrow">tinta · dibujo · narrativa</p>
    <h1>Tinta</h1>
    <p class="hero-phrase">"me amaneció nublado"</p>
    <p class="intro">
      Mini tiras, dibujos sueltos y un universo narrativo sensible que vive
      dentro de D³. Tinta es el espacio donde el trazo cuenta historias.
    </p>
  </section>

  <section class="tinta-here-section">
    <a href="/tinta/tintamap" class="tinta-here-card paper-card" aria-label="Tinta estuvo aquí — explorar los nodos">
      <div class="tinta-here-image">
        <img src="/images/ui/tinta_lapiz.png" alt="Tinta sostiene un lápiz" loading="lazy" />
        <span class="tinta-here-sign" aria-hidden="true">
          <svg viewBox="0 0 220 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
            <rect x="8" y="10" width="200" height="52" rx="3"
                  fill="rgba(255,255,255,0.95)" stroke="#171411" stroke-width="2.5"
                  transform="rotate(-3 108 36)" />
            <text x="108" y="44" text-anchor="middle"
                  font-family="Georgia, serif" font-style="italic" font-size="17"
                  fill="#171411" transform="rotate(-3 108 44)">
              Tinta estuvo aquí
            </text>
          </svg>
        </span>
      </div>
      <div class="tinta-here-copy">
        <p class="eyebrow">una nueva aparición</p>
        <h2>Tinta estuvo aquí</h2>
        <p class="tinta-here-body">
          Encuentra dibujos escondidos, acerca tu teléfono y descubre lo que
          Tinta dejó para ti.
        </p>
        <span class="tinta-here-cta">Explorar los nodos →</span>
      </div>
    </a>
  </section>

  <section class="gallery-section">
    <div class="gallery-grid">
      {featured.map((num) => (
        <div class="gallery-item paper-card">
          <img
            src={`/images/tinta/${num}.webp`}
            alt={`Tinta ${num}`}
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </section>

  <section class="instagram-section">
    <div class="instagram-card paper-card">
      <p class="eyebrow">tinta vive también en instagram</p>
      <h2>Más tinta, más trazos</h2>
      <p>
        Las publicaciones más recientes, historias y el día a día del proyecto
        se comparten en Instagram. Ahí es donde Tinta respira en tiempo real.
      </p>
      <a
        href="https://www.instagram.com/domingosdedibujar/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-instagram"
      >
        Ver más en Instagram
      </a>
    </div>
  </section>

  <section class="archive-section">
    <p class="eyebrow">archivo local</p>
    <h2>Todas las tintas</h2>
    <div class="archive-grid">
      {archive.map((num) => (
        <div class="archive-item">
          <img
            src={`/images/tinta/${num}.webp`}
            alt={`Tinta ${num}`}
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .tinta-hero {
    max-width: 780px;
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    font-weight: 700;
    color: #d9485f;
  }

  .tinta-hero h1 {
    margin: 0 0 0.8rem;
    font-size: clamp(2.8rem, 7vw, 5.2rem);
    line-height: 0.95;
  }

  .hero-phrase {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 3vw, 1.55rem);
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 1rem;
    line-height: 1.4;
  }

  .intro {
    margin: 0;
    max-width: 52ch;
    color: var(--ink-soft);
    line-height: 1.72;
    font-size: 1.02rem;
  }

  /* --- Tinta estuvo aquí (acceso a /tinta/tintamap) --- */
  .tinta-here-section {
    margin-bottom: 2.5rem;
  }

  .tinta-here-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.4rem;
    align-items: center;
    max-width: 860px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .tinta-here-card:hover {
    transform: translate(-1px, -2px);
    box-shadow: 6px 6px 0 #11111133;
  }

  .tinta-here-image {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .tinta-here-image img {
    width: 100%;
    max-width: 180px;
    height: auto;
    display: block;
    transform: rotate(-3deg);
  }

  .tinta-here-sign {
    position: absolute;
    top: -8px;
    right: -14px;
    width: 150px;
    transform: rotate(6deg);
    filter: drop-shadow(2px 2px 0 rgba(17,17,17,0.25));
    pointer-events: none;
  }

  .tinta-here-sign svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .tinta-here-copy .eyebrow {
    color: var(--accent);
  }

  .tinta-here-copy h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1;
  }

  .tinta-here-body {
    margin: 0 0 0.8rem;
    color: var(--ink-soft);
    line-height: 1.7;
    max-width: 46ch;
  }

  .tinta-here-cta {
    display: inline-flex;
    padding: 0.55rem 0.9rem;
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    background: rgba(255,255,255,0.85);
    font-family: var(--font-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.82rem;
    font-weight: 700;
    box-shadow: 3px 3px 0 #11111133;
  }

  /* --- Featured gallery --- */
  .gallery-section {
    margin-bottom: 2.5rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .gallery-item {
    overflow: hidden;
    padding: 0;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: var(--card-radius);
  }

  /* --- Instagram CTA --- */
  .instagram-section {
    margin-bottom: 2.5rem;
  }

  .instagram-card {
    max-width: 860px;
  }

  .instagram-card h2 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.65rem, 4vw, 2.5rem);
    line-height: 0.98;
    max-width: 13ch;
  }

  .instagram-card p {
    margin: 0 0 1rem;
    line-height: 1.72;
    max-width: 55ch;
    color: var(--ink-soft);
  }

  .btn-instagram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.1rem;
    border: 1.5px solid rgba(17, 17, 17, 0.82);
    border-radius: 3px;
    text-decoration: none;
    font-weight: 700;
    color: #111;
    background: rgba(255, 255, 255, 0.74);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    box-shadow: 4px 4px 0 #11111140;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }

  .btn-instagram:hover {
    transform: translateY(-1px);
    box-shadow: 5px 5px 0 #11111133;
  }

  /* --- Archive grid --- */
  .archive-section {
    margin-bottom: 2rem;
  }

  .archive-section h2 {
    margin: 0 0 1rem;
  }

  .archive-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .archive-item {
    overflow: hidden;
    border-radius: var(--card-radius);
    border: 1px solid rgba(17, 17, 17, 0.12);
    box-shadow: 2px 2px 0 #11111118;
  }

  .archive-item img {
    width: 100%;
    display: block;
    transition: transform 0.25s ease;
  }

  .archive-item:hover img {
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }

    .instagram-card h2 {
      max-width: none;
    }

    .tinta-here-card {
      grid-template-columns: 140px 1fr;
      gap: 1rem;
    }

    .tinta-here-image img {
      max-width: 140px;
    }

    .tinta-here-sign {
      width: 120px;
      right: -8px;
      top: -12px;
    }
  }

  @media (max-width: 560px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
    }

    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.45rem;
    }

    .tinta-here-card {
      grid-template-columns: 1fr;
      gap: 0.6rem;
      text-align: left;
    }

    .tinta-here-image {
      justify-content: flex-start;
    }

    .tinta-here-image img {
      max-width: 120px;
    }

    .tinta-here-sign {
      position: relative;
      top: 0;
      right: 0;
      width: 130px;
      margin-top: -20px;
      transform: rotate(-5deg);
    }
  }
</style>
