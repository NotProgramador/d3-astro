---
import BaseLayout from "../layouts/BaseLayout.astro";
import PrimerosTrazosAccordion from "../components/PrimerosTrazosAccordion.astro";
import { orderedExercises } from "../data/exercises";
---

<BaseLayout title="Primeros trazos | D³">
  <section class="page-hero">
    <p class="eyebrow">primeros trazos</p>
    <h1>Ejercicios para empezar sin pelearte con la hoja</h1>
    <p class="intro">
      Esta sección reúne prácticas para soltar la mano, observar mejor, entender
      proporciones y ganar confianza. No hace falta hacerlas en orden ni
      terminarlas perfecto. Lo importante es volver a ellas y repetir.
    </p>
  </section>

  <section class="intro-card paper-card">
    <h2>Cómo usar esta sección</h2>
    <p>
      Puedes usar estos ejercicios como calentamiento, práctica semanal o apoyo
      cuando sientas bloqueo. Algunos incluyen video y otros pueden llevar
      plantillas o guías descargables para acompañar la práctica.
    </p>
  </section>

  <PrimerosTrazosAccordion items={orderedExercises} />
</BaseLayout>

<style>
  .page-hero {
    max-width: 780px;
    margin-bottom: 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    color: #d9485f;
    font-weight: 700;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.3rem, 6vw, 4.6rem);
    line-height: 0.95;
    max-width: 11ch;
  }

  .intro {
    margin: 0;
    max-width: 60ch;
    color: var(--ink-soft);
    line-height: 1.72;
    font-size: 1.05rem;
  }

  .intro-card {
    max-width: 900px;
    margin-bottom: 1.5rem;
  }

  .intro-card h2 {
    margin-bottom: 0.7rem;
  }

  .intro-card p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.72;
    max-width: 64ch;
  }
</style>