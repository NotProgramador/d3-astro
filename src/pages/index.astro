---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroHome from "../components/HeroHome.astro";
import HomeInfoBlocks from "../components/HomeInfoBlocks.astro";
import HomeExplore from "../components/HomeExplore.astro";
---

<BaseLayout title="D³ — Domingos de Dibujar">
  <HeroHome />

  <HomeInfoBlocks />

  <section class="follow-section">
    <div class="follow-card">
      <p class="eyebrow">próximas sesiones</p>
      <h2>La actividad viva sucede en Instagram</h2>
      <p>
        Las sesiones nuevas, fotos, lugares y publicaciones del proyecto se
        comparten allá. La web funciona como archivo, mapa y casa del proyecto.
      </p>

      <a
        href="https://instagram.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-follow"
      >
        Seguir D³ en Instagram
      </a>
    </div>
  </section>

  <HomeExplore />

  <section class="closing">
    <p>
      D³ vive entre el encuentro, el dibujo y la memoria compartida.
    </p>
    <a href="/contacto" class="closing-link">Contacto / Apoya</a>
  </section>
</BaseLayout>

<style>
  .follow-section {
    margin: 2rem 0 3rem;
  }

  .follow-card {
  background: rgba(255, 255, 255, 0.74);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  border: 2px solid #111;
  border-radius: 28px;
  padding: 1.5rem;
  box-shadow: 4px 4px 0 #111;
  max-width: 860px;
}

  .eyebrow {
    margin: 0 0 0.45rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    font-weight: 700;
    color: #d9485f;
  }

  .follow-card h2 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 0.98;
  }

  .follow-card p {
    margin: 0 0 1rem;
    line-height: 1.8;
    max-width: 62ch;
  }

  .btn-follow {
    display: inline-block;
    padding: 0.9rem 1.1rem;
    border: 2px solid #111;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    color: #111;
    background: white;
    box-shadow: 3px 3px 0 #111;
  }

  .closing {
    margin: 3rem 0 1rem;
    padding: 1rem 0 2rem;
  }

  .closing p {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .closing-link {
    font-weight: 700;
    color: #111;
    text-decoration: none;
  }
</style>