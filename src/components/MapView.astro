---
const { places } = Astro.props;
---

<div id="d3-map" class="map-shell" data-places={JSON.stringify(places)}></div>

<script>
  import L, { D3Marker } from "../lib/leaflet-fix";
  import "leaflet/dist/leaflet.css";

  const mapElement = document.getElementById("d3-map");

  if (mapElement) {
    const rawPlaces = mapElement.getAttribute("data-places");
    const places = rawPlaces ? JSON.parse(rawPlaces) : [];

    if (places.length > 0) {
      const map = L.map(mapElement).setView([19.4326, -99.1332], 11);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap contributors"
      }).addTo(map);

      const bounds: [number, number][] = [];

      places.forEach((place: any) => {
        if (typeof place.lat === "number" && typeof place.lng === "number") {
          const marker = L.marker([place.lat, place.lng], {
            icon: D3Marker
          }).addTo(map);

          marker.bindPopup(`
            <div class="d3-popup">
              <strong>${place.name}</strong><br/>
              <span>${place.type}</span><br/>
              <a href="/mapa-d3/${place.slug}">Ver lugar</a>
            </div>
          `);

          bounds.push([place.lat, place.lng]);
        }
      });

      if (bounds.length > 1) {
        map.fitBounds(bounds, { padding: [40, 40] });
      } else if (bounds.length === 1) {
        map.setView(bounds[0], 14);
      }

      setTimeout(() => {
        map.invalidateSize();
      }, 100);
    }
  }
</script>

<style>
  .map-shell {
    width: 100%;
    min-height: 460px;
    border: 2px solid #111;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 4px 4px 0 #111;
    background: rgba(255, 255, 255, 0.72);
  }

  :global(.leaflet-container) {
    width: 100%;
    height: 100%;
    min-height: 460px;
    border-radius: 28px;
    font-family: inherit;
  }

  :global(.leaflet-popup-content-wrapper) {
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.95);
    border: 2px solid #111;
    box-shadow: 3px 3px 0 #111;
  }

  :global(.leaflet-popup-content) {
    margin: 12px 14px;
    line-height: 1.5;
  }

  :global(.leaflet-popup-content a) {
    color: #111;
    text-decoration: none;
    font-weight: 700;
  }

  :global(.leaflet-popup-tip) {
    background: white;
    border: 2px solid #111;
  }
</style>