---
const path = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/primeros-trazos", label: "Primeros trazos" },
  { href: "/mapa-d3", label: "Mapa D³" },
  { href: "/tinta", label: "Tinta" },
  { href: "/contacto", label: "Contacto / Apoya" }
];

const isActive = (href: string) => {
  if (href === "/") return path === "/";
  return path.startsWith(href);
};
---

<header class="site-header">
  <div class="header-inner">
    <div class="top-row">
      <a href="/" class="brand">
        <img src="/images/ui/d3logo.PNG" alt="D³" class="brand-logo" />
        <span class="brand-text">D³ — Domingos de Dibujar</span>
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Abrir menú"
      >
        <span class="menu-toggle__line"></span>
        <span class="menu-toggle__line"></span>
        <span class="menu-toggle__text">Menú</span>
      </button>
    </div>

    <nav class="nav nav-desktop" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a href={item.href} class={`nav-link ${isActive(item.href) ? "is-active" : ""}`}>
          <span>{item.label}</span>
          {isActive(item.href) && (
            <img src="/images/ui/equis.PNG" alt="" class="nav-x" />
          )}
        </a>
      ))}
    </nav>

    <nav id="mobile-nav" class="nav-mobile" aria-label="Navegación móvil" hidden>
      <div class="mobile-nav-panel paper-card">
        {navItems.map((item) => (
          <a href={item.href} class={`mobile-link ${isActive(item.href) ? "is-active" : ""}`}>
            <span>{item.label}</span>
            {isActive(item.href) && (
              <img src="/images/ui/equis.PNG" alt="" class="mobile-nav-x" />
            )}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const toggleButton = document.querySelector(".menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");

  if (toggleButton && mobileNav) {
    const closeMenu = () => {
      toggleButton.setAttribute("aria-expanded", "false");
      toggleButton.setAttribute("aria-label", "Abrir menú");
      mobileNav.setAttribute("hidden", "");
      document.body.classList.remove("mobile-menu-open");
    };

    const openMenu = () => {
      toggleButton.setAttribute("aria-expanded", "true");
      toggleButton.setAttribute("aria-label", "Cerrar menú");
      mobileNav.removeAttribute("hidden");
      document.body.classList.add("mobile-menu-open");
    };

    toggleButton.addEventListener("click", () => {
      const expanded = toggleButton.getAttribute("aria-expanded") === "true";
      if (expanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 900) {
        closeMenu();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(253, 252, 249, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
  }

  .header-inner {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    padding: 12px 32px 12px 88px;
    min-height: var(--header-height-desktop);
    display: grid;
    align-items: center;
    gap: 0.75rem;
  }

  .top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: #111;
    min-width: 0;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.01em;
    max-width: 22ch;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid rgba(17, 17, 17, 0.82);
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.78);
    color: #111;
    box-shadow: 4px 4px 0 #11111124;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    flex-shrink: 0;
  }

  .menu-toggle__line {
    display: block;
    width: 12px;
    height: 1.5px;
    background: #111;
  }

  .menu-toggle__text {
    line-height: 1;
  }

  .nav-desktop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.8rem 1rem;
    min-width: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #111;
    font-size: 0.96rem;
    font-weight: 500;
    padding: 0.15rem 0 0.95rem;
    white-space: nowrap;
  }

  .nav-link span {
    position: relative;
    z-index: 1;
  }

  .nav-link:hover {
    color: rgba(17, 17, 17, 0.76);
  }

  .nav-x {
    position: absolute;
    bottom: -1px;
    width: 20px;
    height: auto;
    pointer-events: none;
  }

  .nav-mobile {
    display: none;
  }

  .mobile-nav-panel {
    padding: 0.55rem;
    display: grid;
    gap: 0.2rem;
  }

  .mobile-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 44px;
    padding: 0.8rem 0.85rem;
    text-decoration: none;
    color: #111;
    font-weight: 600;
    border-radius: 3px;
  }

  .mobile-link:hover {
    background: rgba(17, 17, 17, 0.04);
  }

  .mobile-link.is-active {
    font-weight: 700;
  }

  .mobile-nav-x {
    width: 18px;
    margin-left: 0.5rem;
    flex-shrink: 0;
  }

  .is-active {
    font-weight: 700;
  }

  @media (max-width: 1100px) {
    .header-inner {
      width: min(1240px, calc(100% - 32px));
      padding-right: 18px;
    }

    .brand-text {
      font-size: 0.98rem;
      max-width: 18ch;
    }

    .nav-link {
      font-size: 0.93rem;
    }
  }

  @media (max-width: 900px) {
    .header-inner {
      width: calc(100% - 20px);
      padding: 10px 6px 10px 48px;
      min-height: auto;
      gap: 0.7rem;
    }

    .brand {
      gap: 0.7rem;
      min-width: 0;
      flex: 1;
    }

    .brand-logo {
      width: 36px;
      height: 36px;
    }

    .brand-text {
      font-size: 0.95rem;
      max-width: none;
      line-height: 1.12;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .nav-desktop {
      display: none;
    }

    .nav-mobile {
      display: block;
      width: 100%;
    }

    .mobile-nav-panel {
      width: 100%;
    }
  }

  @media (max-width: 560px) {
    .header-inner {
      width: calc(100% - 16px);
      padding: 10px 2px 10px 42px;
    }

    .brand-text {
      font-size: 0.92rem;
    }

    .menu-toggle {
      padding: 0.66rem 0.78rem;
      gap: 0.42rem;
      font-size: 0.92rem;
    }

    .mobile-link {
      padding: 0.78rem 0.8rem;
      font-size: 0.95rem;
    }
  }
</style>