---
const path = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/primeros-trazos", label: "Primeros trazos" },
  { href: "/mapa-d3", label: "Mapa D³" },
  { href: "/tinta", label: "Tinta" },
  { href: "/contacto", label: "Contacto / Apoya" }
];

const isActive = (href: string) => {
  if (href === "/") return path === "/";
  return path.startsWith(href);
};
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/images/ui/d3logo.PNG" alt="D³" class="brand-logo" />
      <span class="brand-text">D³ — Domingos de Dibujar</span>
    </a>

    <nav class="nav nav-desktop" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a href={item.href} class={`nav-link ${isActive(item.href) ? "is-active" : ""}`}>
          <span>{item.label}</span>
          {isActive(item.href) && (
            <img src="/images/ui/equis.PNG" alt="" class="nav-x" />
          )}
        </a>
      ))}
    </nav>

    <details class="mobile-menu">
      <summary class="mobile-menu-toggle">
        <span class="menu-lines" aria-hidden="true">— —</span>
        <span>Menú</span>
      </summary>

      <nav class="mobile-panel" aria-label="Navegación móvil">
        {navItems.map((item) => (
          <a href={item.href} class={`mobile-link ${isActive(item.href) ? "is-active" : ""}`}>
            <span>{item.label}</span>
            {isActive(item.href) && (
              <img src="/images/ui/equis.PNG" alt="" class="mobile-x" />
            )}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 252, 246, 0.78);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
  }

  .header-inner {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    padding: 12px 32px 12px 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.25rem;
    min-height: var(--header-height-desktop);
    position: relative;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: #111;
    min-width: 0;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.01em;
    max-width: 22ch;
  }

  .nav-desktop {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.8rem 1rem;
    min-width: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #111;
    font-size: 0.96rem;
    font-weight: 500;
    padding: 0.15rem 0 0.95rem;
    white-space: nowrap;
  }

  .nav-link span {
    position: relative;
    z-index: 1;
  }

  .nav-link:hover {
    color: rgba(17, 17, 17, 0.76);
  }

  .nav-x {
    position: absolute;
    bottom: -1px;
    width: 20px;
    height: auto;
    pointer-events: none;
  }

  .is-active {
    font-weight: 700;
  }

  .mobile-menu {
    display: none;
  }

  .mobile-menu summary {
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  @media (max-width: 1100px) {
    .header-inner {
      width: min(1240px, calc(100% - 32px));
      padding-right: 18px;
    }

    .brand-text {
      font-size: 0.98rem;
      max-width: 18ch;
    }

    .nav-link {
      font-size: 0.93rem;
    }
  }

  @media (max-width: 900px) {
    .header-inner {
      width: calc(100% - 20px);
      padding: 10px 6px 10px 48px;
      min-height: auto;
      align-items: start;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.9rem 0.9rem;
    }

    .nav-desktop {
      display: none;
    }

    .brand {
      min-width: 0;
      align-self: center;
    }

    .brand-logo {
      width: 36px;
      height: 36px;
    }

    .brand-text {
      font-size: 0.96rem;
      line-height: 1.12;
      max-width: 12ch;
    }

    .mobile-menu {
      display: block;
      position: relative;
      align-self: start;
    }

    .mobile-menu-toggle {
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      min-height: 48px;
      padding: 0.8rem 1rem;
      border: 1.5px solid rgba(17, 17, 17, 0.82);
      border-radius: 3px;
      background: rgba(255, 255, 255, 0.74);
      box-shadow: 4px 4px 0 #11111140;
      font-weight: 700;
      color: #111;
      user-select: none;
    }

    .menu-lines {
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .mobile-panel {
      position: absolute;
      right: 0;
      top: calc(100% + 0.85rem);
      width: min(360px, calc(100vw - 44px));
      background: rgba(254, 254, 254, 0.73);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1.5px solid rgba(17, 17, 17, 0.82);
      border-radius: 3px;
      box-shadow: 6px 6px 0 #11111133;
      padding: 0.7rem;
      display: grid;
      gap: 0.2rem;
    }

    .mobile-link {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 52px;
      padding: 0.9rem 0.8rem;
      text-decoration: none;
      color: #111;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 3px;
    }

    .mobile-link:hover {
      background: rgba(17, 17, 17, 0.04);
    }

    .mobile-link.is-active {
      font-weight: 700;
    }

    .mobile-x {
      width: 22px;
      height: auto;
      flex-shrink: 0;
    }
  }

  @media (max-width: 560px) {
    .header-inner {
      width: calc(100% - 16px);
      padding: 10px 2px 10px 42px;
      gap: 0.8rem;
    }

    .brand-text {
      font-size: 0.93rem;
      line-height: 1.12;
      max-width: 11ch;
    }

    .mobile-menu-toggle {
      padding: 0.78rem 0.9rem;
      min-height: 46px;
    }

    .mobile-panel {
      width: min(340px, calc(100vw - 36px));
    }

    .mobile-link {
      font-size: 0.98rem;
      min-height: 50px;
    }
  }
</style>