---
const path = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/primeros-trazos", label: "Primeros trazos" },
  { href: "/mapa-d3", label: "Mapa D³" },
  { href: "/tinta", label: "Tinta" },
  { href: "/contacto", label: "Contacto / Apoya" }
];

const isActive = (href: string) => {
  if (href === "/") return path === "/";
  return path.startsWith(href);
};
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/images/ui/d3logo.PNG" alt="D³" class="brand-logo" />
      <span class="brand-text">D³ — Domingos de Dibujar</span>
    </a>

    <nav class="nav">
      {navItems.map((item) => (
        <a href={item.href} class={`nav-link ${isActive(item.href) ? "is-active" : ""}`}>
          <span>{item.label}</span>
          {isActive(item.href) && (
            <img src="/images/ui/equis.PNG" alt="" class="nav-x" />
          )}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 252, 246, 0.74);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
  }

  .header-inner {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    padding: 14px 32px 14px 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: #111;
    min-width: 0;
  }

  .brand-logo {
    width: 42px;
    height: 42px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.01em;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.9rem 1.05rem;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #111;
    font-size: 0.98rem;
    font-weight: 500;
    padding: 0.15rem 0 0.95rem;
  }

  .nav-link span {
    position: relative;
    z-index: 1;
  }

  .nav-link:hover {
    color: rgba(17, 17, 17, 0.76);
  }

  .nav-x {
    position: absolute;
    bottom: -1px;
    width: 20px;
    height: auto;
    pointer-events: none;
  }

  .is-active {
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .header-inner {
      width: min(1240px, calc(100% - 24px));
      padding: 12px 12px 12px 56px;
      align-items: flex-start;
      flex-direction: column;
    }

    .nav {
      justify-content: flex-start;
      gap: 0.8rem 1rem;
    }

    .brand-text {
      font-size: 0.98rem;
    }

    .nav-link {
      padding-bottom: 0.8rem;
      font-size: 0.95rem;
    }
  }
</style>