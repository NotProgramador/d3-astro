---
const path = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/primeros-trazos", label: "Primeros trazos" },
  { href: "/mapa-d3", label: "Mapa D³" },
  { href: "/tinta", label: "Tinta" },
  { href: "/contacto", label: "Contacto / Apoya" }
];

const isActive = (href: string) => {
  if (href === "/") return path === "/";
  return path.startsWith(href);
};
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/images/ui/d3logo.PNG" alt="D³" class="brand-logo" />
      <span class="brand-text">D³ — Domingos de Dibujar</span>
    </a>

    <nav class="nav" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a href={item.href} class={`nav-link ${isActive(item.href) ? "is-active" : ""}`}>
          <span>{item.label}</span>
          {isActive(item.href) && (
            <img src="/images/ui/equis.PNG" alt="" class="nav-x" />
          )}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(253, 252, 249, 0.36);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
  }

  .header-inner {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    padding: 12px 32px 12px 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.25rem;
    min-height: var(--header-height-desktop);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: #111;
    min-width: 0;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .brand-text {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.01em;
    max-width: 22ch;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.8rem 1rem;
    min-width: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #111;
    font-size: 0.96rem;
    font-weight: 500;
    padding: 0.15rem 0 0.95rem;
    white-space: nowrap;
  }

  .nav-link span {
    position: relative;
    z-index: 1;
  }

  .nav-link:hover {
    color: rgba(17, 17, 17, 0.76);
  }

  .nav-x {
    position: absolute;
    bottom: -1px;
    width: 20px;
    height: auto;
    pointer-events: none;
  }

  .is-active {
    font-weight: 700;
  }

  @media (max-width: 1100px) {
    .header-inner {
      width: min(1240px, calc(100% - 32px));
      padding-right: 18px;
    }

    .brand-text {
      font-size: 0.98rem;
      max-width: 18ch;
    }

    .nav-link {
      font-size: 0.93rem;
    }
  }

  @media (max-width: 900px) {
    .header-inner {
      width: calc(100% - 20px);
      padding: 10px 6px 10px 48px;
      align-items: flex-start;
      flex-direction: column;
      min-height: var(--header-height-mobile);
    }

    .brand {
      gap: 0.7rem;
    }

    .brand-logo {
      width: 36px;
      height: 36px;
    }

    .brand-text {
      font-size: 0.96rem;
      max-width: none;
    }

    .nav {
      width: 100%;
      justify-content: flex-start;
      gap: 0.65rem 0.95rem;
      padding-top: 0.1rem;
    }

    .nav-link {
      padding-bottom: 0.72rem;
      font-size: 0.93rem;
      line-height: 1.15;
    }

    .nav-x {
      width: 18px;
      bottom: -1px;
    }
  }

  @media (max-width: 560px) {
    .header-inner {
      width: calc(100% - 16px);
      padding: 10px 2px 10px 42px;
    }

    .brand-text {
      font-size: 0.93rem;
      line-height: 1.12;
    }

    .nav {
      gap: 0.55rem 0.8rem;
    }

    .nav-link {
      font-size: 0.9rem;
      padding-bottom: 0.68rem;
    }
  }
</style>