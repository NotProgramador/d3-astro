---
const path = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/primeros-trazos", label: "Primeros trazos" },
  { href: "/mapa-d3", label: "Mapa D³" },
  { href: "/tinta", label: "Tinta" },
  { href: "/contacto", label: "Contacto / Apoya" }
];

const isActive = (href: string) => {
  if (href === "/") return path === "/";
  return path.startsWith(href);
};
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/images/ui/d3logo.PNG" alt="D³" class="brand-logo" />
      <span>D³ — Domingos de Dibujar</span>
    </a>

    <nav class="nav">
      {navItems.map((item) => (
        <a href={item.href} class={`nav-link ${isActive(item.href) ? "is-active" : ""}`}>
          <span>{item.label}</span>
          {isActive(item.href) && (
            <img src="/images/ui/equis.PNG" alt="" class="nav-x" />
          )}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgb(254, 254, 254);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(17,17,17,0.10);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
}

  .header-inner {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
    padding: 14px 32px 14px 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #111;
    font-weight: 700;
    min-width: 0;
  }

  .brand-logo {
    width: 42px;
    height: 42px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 1.1rem;
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    color: #111;
    font-weight: 500;
    padding-bottom: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .nav-link span {
    position: relative;
    z-index: 1;
  }

  .nav-x {
    position: absolute;
    bottom: -2px;
    width: 22px;
    height: auto;
    pointer-events: none;
  }

  .is-active {
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .header-inner {
      width: min(1240px, calc(100% - 24px));
      padding: 12px 12px 12px 56px;
      align-items: flex-start;
      flex-direction: column;
    }

    .nav {
      justify-content: flex-start;
      gap: 0.9rem 1rem;
    }

    .brand span {
      font-size: 0.95rem;
    }
  }
</style>