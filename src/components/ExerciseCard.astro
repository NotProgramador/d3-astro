---
interface Props {
  exercise: {
    title: string;
    duration: string;
    purpose: string;
    description: string;
  };
}

const { exercise } = Astro.props;
---

<article class="exercise-card">
  <p class="duration">{exercise.duration}</p>
  <h3>{exercise.title}</h3>
  <p class="description">{exercise.description}</p>
  <p class="purpose"><strong>Para qué sirve:</strong> {exercise.purpose}</p>
</article>

<style>
  .exercise-card {
    background: rgba(255, 255, 255, 0.74);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 2px solid #111;
    border-radius: 24px;
    padding: 1.2rem;
    box-shadow: 4px 4px 0 #111;
    display: grid;
    gap: 0.7rem;
  }

  .duration {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    color: #d9485f;
  }

  h3 {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.1;
  }

  .description,
  .purpose {
    margin: 0;
    line-height: 1.7;
  }
</style>