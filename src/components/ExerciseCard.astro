---
interface Props {
  exercise: {
    title: string;
    duration: string;
    purpose: string;
    description: string;
  };
}

const { exercise } = Astro.props;
---

<article class="exercise-card paper-card">
  <p class="duration">{exercise.duration}</p>
  <h3>{exercise.title}</h3>
  <p class="description">{exercise.description}</p>
  <p class="purpose"><strong>Para qué sirve:</strong> {exercise.purpose}</p>
</article>

<style>
  .exercise-card {
    display: grid;
    gap: 0.72rem;
  }

  .duration {
    margin: 0;
    font-family: var(--font-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    color: #d9485f;
  }

  h3 {
    margin: 0;
    font-size: 1.32rem;
    line-height: 1.08;
    max-width: 16ch;
  }

  .description,
  .purpose {
    margin: 0;
    line-height: 1.72;
    color: var(--ink-soft);
  }

  .purpose strong {
    color: var(--ink);
  }
</style>