---
interface Props {
  lat: number;
  lng: number;
  name: string;
}

const { lat, lng, name } = Astro.props;
---

<div
  id={`place-map-${lat}-${lng}`}
  class="mini-map-shell"
  data-lat={lat}
  data-lng={lng}
  data-name={name}
></div>

<script>
  import L, { D3Marker } from "../lib/leaflet-fix";
  import "leaflet/dist/leaflet.css";

  const elements = document.querySelectorAll(".mini-map-shell");

  elements.forEach((mapElement) => {
    const lat = Number(mapElement.getAttribute("data-lat"));
    const lng = Number(mapElement.getAttribute("data-lng"));
    const name = mapElement.getAttribute("data-name") || "Lugar";

    if (!Number.isNaN(lat) && !Number.isNaN(lng)) {
      const map = L.map(mapElement, {
        zoomControl: false,
        dragging: true,
        scrollWheelZoom: false
      }).setView([lat, lng], 15);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap contributors"
      }).addTo(map);

      const marker = L.marker([lat, lng], {
        icon: D3Marker
      }).addTo(map);

      marker.bindPopup(`<strong>${name}</strong>`);

      setTimeout(() => {
        map.invalidateSize();
      }, 100);
    }
  });
</script>

<style>
  .mini-map-shell {
    width: 100%;
    min-height: 260px;
    border: 2px solid #111;
    border-radius: 18px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.7);
  }

  :global(.mini-map-shell .leaflet-container) {
    width: 100%;
    height: 100%;
    min-height: 260px;
    border-radius: 18px;
  }
</style>