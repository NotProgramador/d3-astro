---
export interface Props {
  mode?: 'public' | 'private';
}
const { mode = 'public' } = Astro.props;
---

<article class={`tm-cred paper-card mode-${mode}`} data-mode={mode}>
  <header class="tm-cred-head">
    <p class="eyebrow">credencial de explorador</p>
    <h2 class="tm-cred-title">Tinta estuvo aquí</h2>
  </header>

  <div class="tm-cred-body">
    <div class="tm-cred-row">
      <span class="label">ID público</span>
      <code class="value" data-slot="public_id">TINTA-????</code>
    </div>

    <div class="tm-cred-row">
      <span class="label">Nodos descubiertos</span>
      <span class="value" data-slot="discovered">0</span>
    </div>

    <div class="tm-cred-row">
      <span class="label">Familias iniciadas</span>
      <span class="value" data-slot="families_started">0</span>
    </div>

    <div class="tm-cred-row">
      <span class="label">Familias completadas</span>
      <span class="value" data-slot="families_completed">0</span>
    </div>

    <div class="tm-cred-row">
      <span class="label">Creada</span>
      <span class="value" data-slot="created_at">—</span>
    </div>

    {mode === 'private' && (
      <div class="tm-cred-row recovery">
        <span class="label">Código de recuperación</span>
        <code class="value big" data-slot="recovery_code">D3-????-????-????</code>
      </div>
    )}
  </div>

  <footer class="tm-cred-foot">
    {mode === 'private' ? (
      <>
        <div class="tm-cred-actions">
          <button type="button" data-action="copy-recovery" class="btn-line">Copiar código</button>
          <a href="/tinta/tintamap/credencial?attach=email" class="btn-line">Enviar a correo</a>
        </div>
        <p class="warning">
          Guarda este código en un lugar seguro. Te permitirá recuperar tu recorrido
          si cambias de dispositivo o borras tus datos.
        </p>
      </>
    ) : (
      <p class="hint">
        Esta vista es pública: no incluye tu código de recuperación.
      </p>
    )}
  </footer>
</article>

<style>
  .tm-cred { max-width: 520px; }
  .eyebrow {
    margin: 0 0 0.4rem;
    font-family: var(--font-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
  }
  .tm-cred-title {
    margin: 0 0 1.2rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.6rem;
  }
  .tm-cred-body { display: grid; gap: 0.6rem; }
  .tm-cred-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    border-bottom: 1px dashed rgba(17,17,17,0.18);
    padding-bottom: 0.4rem;
  }
  .label {
    font-family: var(--font-accent);
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .value {
    font-family: var(--font-display);
    font-size: 1rem;
  }
  .value.big { font-size: 1.05rem; }
  .recovery .value { color: var(--accent); }
  .tm-cred-foot { margin-top: 1rem; }
  .tm-cred-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .btn-line {
    display: inline-flex;
    padding: 0.5rem 0.8rem;
    border: 1.5px solid var(--ink);
    border-radius: 3px;
    background: rgba(255,255,255,0.7);
    cursor: pointer;
    font-family: var(--font-accent);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }
  .warning {
    margin: 0;
    padding: 0.6rem 0.7rem;
    background: rgba(217,72,95,0.08);
    border-left: 3px solid var(--accent);
    font-size: 0.88rem;
    color: var(--ink);
  }
  .hint {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
</style>
