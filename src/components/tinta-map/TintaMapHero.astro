---
export interface Props {
  eyebrow?: string;
  title?: string;
  phrase?: string;
  body?: string;
}
const {
  eyebrow = 'tinta · estuvo aquí',
  title = 'Tinta estuvo aquí',
  phrase = 'hay dibujos escondidos cerca de ti.',
  body = 'Cada aparición de Tinta está ligada a una ubicación real. Acerca tu teléfono a una etiqueta para descubrir un nodo, registrar tu recorrido y desbloquear contenido.',
} = Astro.props;
---

<section class="tm-hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p class="phrase">"{phrase}"</p>
  <p class="body">{body}</p>
</section>

<style>
  .tm-hero {
    max-width: 780px;
    margin-bottom: 1.8rem;
  }
  .eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
  }
  .tm-hero h1 {
    margin: 0 0 0.8rem;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 0.98;
  }
  .phrase {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 3vw, 1.45rem);
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 1rem;
    line-height: 1.45;
  }
  .body {
    margin: 0;
    max-width: 58ch;
    color: var(--ink-soft);
    line-height: 1.72;
    font-size: 1.02rem;
  }
</style>
