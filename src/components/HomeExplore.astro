---
const items = [
  {
    title: "Primeros trazos",
    text: "Ejercicios y tips para soltar la mano y mirar distinto.",
    href: "/primeros-trazos"
  },
  {
    title: "Mapa D³",
    text: "Un archivo de los lugares donde hemos dibujado.",
    href: "/mapa-d3"
  },
  {
    title: "Tinta",
    text: "Mini tiras y un universo narrativo sensible dentro del proyecto.",
    href: "/tinta"
  }
];
---

<section class="explore">
  <div class="section-head">
    <p class="eyebrow">explora</p>
    <h2>Recorre el proyecto</h2>
  </div>

  <div class="explore-grid">
    {items.map((item) => (
      <a href={item.href} class="explore-card paper-card">
        <h3>{item.title}</h3>
        <p>{item.text}</p>
        <span>Entrar →</span>
      </a>
    ))}
  </div>
</section>

<style>
  .explore {
    margin: 3rem 0;
  }

  .section-head {
    margin-bottom: 1.25rem;
  }

  .eyebrow {
    margin: 0 0 0.4rem;
    font-family: var(--font-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    font-weight: 700;
    color: #d9485f;
  }

  .section-head h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 0.95;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .explore-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    color: #111;
    min-height: 200px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .explore-card:hover {
    transform: translateY(-2px);
    box-shadow: 5px 5px 0 #11111133;
  }

  .explore-card h3 {
    margin: 0 0 0.75rem;
    font-size: 1.35rem;
    line-height: 1.06;
    max-width: 12ch;
  }

  .explore-card p {
    margin: 0 0 1rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 28ch;
  }

  .explore-card span {
    font-weight: 700;
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .explore-grid {
      grid-template-columns: 1fr;
    }

    .explore-card {
      min-height: auto;
    }

    .explore-card h3,
    .explore-card p {
      max-width: none;
    }
  }
</style>